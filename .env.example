# ─── Database Configuration
DATABASE_URL=postgresql+psycopg://user:passsword@host:port/database

# ─── JWT Security Configuration
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# ─── Application Configuration
DEBUG=true
ENVIRONMENT=development

# ─── CORS Configuration
CORS_ORIGINS=["http://localhost:5173"]

# ─── Observability
# Leave empty in development; set in staging/production to enable Sentry.
SENTRY_DSN=
# Python log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Seed Data (Optional)
# DEMO_EMAIL=demo@tablio.co
# DEMO_PASSWORD=demo1234
# DEMO_SLUG=demo
